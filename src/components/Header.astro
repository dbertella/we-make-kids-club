---
import HeaderLink from "./HeaderLink.astro";
import config from "../content/config/config.json";
import IconLink from "./react/IconLink";
import ReactIcon from "./react/icon";
---

<header>
  <nav aria-label="Main navigation">
    <h2>
      <a href="/">
        <img class="logo" src="/logo.svg" alt="We Make Kids Club Logo" />
      </a>
    </h2>
    <button
      id="menu"
      aria-label="Open Menu"
      aria-controls="primary-navigation"
      aria-expanded="false"
      class="burger"
    >
      <svg
        width="32px"
        height="32px"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M4 5C3.44772 5 3 5.44772 3 6C3 6.55228 3.44772 7 4 7H20C20.5523 7 21 6.55228 21 6C21 5.44772 20.5523 5 20 5H4ZM7 12C7 11.4477 7.44772 11 8 11H20C20.5523 11 21 11.4477 21 12C21 12.5523 20.5523 13 20 13H8C7.44772 13 7 12.5523 7 12ZM13 18C13 17.4477 13.4477 17 14 17H20C20.5523 17 21 17.4477 21 18C21 18.5523 20.5523 19 20 19H14C13.4477 19 13 18.5523 13 18Z"
          fill="currentColor"></path>
      </svg>
    </button>
    <div id="primary-navigation" class="navbar">
      <button id="menu-close" aria-label="Close Menu" class="burger top-right">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="54px"
          height="54px"
          viewBox="0 0 24 24"
        >
          <path
            d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z"
            fill="currentColor"></path>
        </svg>
      </button>
      <div class="internal-links">
        {
          config.nav.map((nav) => (
            <HeaderLink href={nav.link}>{nav.title}</HeaderLink>
          ))
        }
      </div>
      <div class="social-links">
        {
          config?.contactLinks?.map((link) => {
            return <IconLink {...link} />;
          })
        }
        <a class="icon-link cart-link" href="/store/cart" aria-label="Shopping cart, 0 items">
          <span class="sr-only">Shopping cart</span>
          <ReactIcon iconName="TbShoppingCart" />
          <span class="cart-count" id="header-cart-count" aria-live="polite" hidden>0</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const updateHeaderCart = () => {
    const countElement = document.getElementById("header-cart-count");
    const cartLink = document.querySelector(".cart-link");
    if (!countElement || !cartLink) return;

    let count = 0;
    try {
      const cart = JSON.parse(localStorage.getItem("wemakekidsclub-cart") || "[]");
      count = Array.isArray(cart) ? cart.length : 0;
    } catch {}

    countElement.textContent = String(count);
    countElement.hidden = count === 0;
    cartLink.setAttribute("aria-label", `Shopping cart, ${count} ${count === 1 ? "item" : "items"}`);
  };

  updateHeaderCart();
  window.addEventListener("wmkc:cart-updated", updateHeaderCart);
  window.addEventListener("storage", updateHeaderCart);

  document.addEventListener("astro:page-load", () => {
    updateHeaderCart();
    const menuButton = document.getElementById("menu");
    const closeButton = document.getElementById("menu-close");
    const navbar = document.getElementById("primary-navigation");
    if (!menuButton || !closeButton || !navbar) return;

    const closeMenu = () => {
      navbar.classList.remove("show");
      menuButton.setAttribute("aria-expanded", "false");
      menuButton.focus();
    };

    menuButton.addEventListener("click", () => {
      navbar.classList.add("show");
      menuButton.setAttribute("aria-expanded", "true");
      closeButton.focus();
    });
    closeButton.addEventListener("click", closeMenu);
    navbar.querySelectorAll(".internal-links a").forEach((link) => {
      link.addEventListener("click", () => {
        navbar.classList.remove("show");
        menuButton.setAttribute("aria-expanded", "false");
      });
    });
    navbar.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && navbar.classList.contains("show")) closeMenu();
    });
  });
</script>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: 1280px;
    min-height: 5rem;
    margin: 0 auto;
  }
  nav a {
    padding: 0.75em 0.5em;
    color: var(--primary);
    border-bottom: 4px solid transparent;
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--secondary);
  }

  .navbar {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .navbar .social-links {
    align-items: center;
    margin-top: 0;
  }

  .navbar .social-links a.cart-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0;
    border-bottom: 0;
    color: var(--secondary);
    transition: color 0.2s ease;
  }

  .navbar .social-links a.cart-link :global(svg) {
    width: 32px;
    height: 32px;
  }

  .navbar .social-links a.cart-link:hover,
  .navbar .social-links a.cart-link:focus-visible {
    color: var(--primary);
  }

  .cart-count {
    position: absolute;
    top: -0.65rem;
    right: -0.4rem;
    display: inline-grid;
    min-width: 1rem;
    height: 1rem;
    place-items: center;
    border-radius: 50%;
    padding: 0 0.1rem;
    background: var(--primary);
    color: white;
    font-size: 0.7rem;
    line-height: 1;
  }

  .cart-count[hidden] {
    display: none;
  }

  .burger {
    display: none;
    cursor: pointer;
    background: none;
    border: none;
    color: var(--secondary);
  }

  .top-right {
    position: absolute;
    top: 0;
    right: 0;
  }
  @media (max-width: 720px) {
    .burger {
      display: block;
      position: absolute;
      top: 50%;
      right: 0;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      transform: translateY(-50%);
    }
    .navbar .top-right {
      top: 0;
      transform: none;
    }
    .navbar {
      display: none;
      position: fixed;
      top: 0;
      bottom: 0;
      right: 0;
      z-index: 20;
      width: min(320px, 100vw);
      flex-direction: column;
      background-color: var(--background-cream);
      box-shadow: var(--box-shadow);
      &.show {
        display: flex;
      }
    }
    .social-links {
      padding: 3rem 0;
    }
    .internal-links {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      flex: 1;
    }
    nav a {
      font-size: 1.25rem;
    }
    nav a.active {
      border-bottom: 4px solid transparent;
    }
  }
</style>
