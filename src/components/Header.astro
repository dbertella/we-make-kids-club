---
import HeaderLink from "./HeaderLink.astro";
import config from "../content/config/config.json";
import IconLink from "./react/IconLink";
import ReactIcon from "./react/icon";
---

<header>
  <nav aria-label="Main navigation">
    <h2>
      <a href="/">
        <img class="logo" src="/logo.svg" alt="We Make Kids Club Logo" />
      </a>
    </h2>
    <div class="mobile-actions">
      <a class="icon-link cart-link mobile-cart-link" href="/shop/cart" aria-label="Shopping cart, 0 items">
        <span class="sr-only">Shopping cart</span>
        <ReactIcon iconName="TbShoppingCart" />
        <span class="cart-count" aria-live="polite" hidden>0</span>
      </a>
      <button
        id="menu"
        aria-label="Open Menu"
        aria-controls="primary-navigation"
        aria-expanded="false"
        class="burger"
      >
        <svg
          width="32px"
          height="32px"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M4 5C3.44772 5 3 5.44772 3 6C3 6.55228 3.44772 7 4 7H20C20.5523 7 21 6.55228 21 6C21 5.44772 20.5523 5 20 5H4ZM7 12C7 11.4477 7.44772 11 8 11H20C20.5523 11 21 11.4477 21 12C21 12.5523 20.5523 13 20 13H8C7.44772 13 7 12.5523 7 12ZM13 18C13 17.4477 13.4477 17 14 17H20C20.5523 17 21 17.4477 21 18C21 18.5523 20.5523 19 20 19H14C13.4477 19 13 18.5523 13 18Z"
            fill="currentColor"></path>
        </svg>
      </button>
    </div>
    <div id="primary-navigation" class="navbar">
      <button id="menu-close" aria-label="Close Menu" class="burger top-right">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="54px"
          height="54px"
          viewBox="0 0 24 24"
        >
          <path
            d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z"
            fill="currentColor"></path>
        </svg>
      </button>
      <div class="internal-links">
        {
          config.nav.map((nav) => (
            <HeaderLink href={nav.link}>{nav.title}</HeaderLink>
          ))
        }
      </div>
      <div class="social-links">
        {
          config?.contactLinks?.map((link) => {
            return <IconLink {...link} />;
          })
        }
        <a class="icon-link cart-link" href="/shop/cart" aria-label="Shopping cart, 0 items">
          <span class="sr-only">Shopping cart</span>
          <ReactIcon iconName="TbShoppingCart" />
          <span class="cart-count" aria-live="polite" hidden>0</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const updateHeaderCart = () => {
    let count = 0;
    try {
      const cart = JSON.parse(localStorage.getItem("wemakekidsclub-cart") || "[]");
      count = Array.isArray(cart) ? cart.length : 0;
    } catch {}

    document.querySelectorAll(".cart-link").forEach((cartLink) => {
      const countElement = cartLink.querySelector(".cart-count");
      if (!(countElement instanceof HTMLElement)) return;

      countElement.textContent = String(count);
      countElement.hidden = count === 0;
      cartLink.setAttribute("aria-label", `Shopping cart, ${count} ${count === 1 ? "item" : "items"}`);
    });
  };

  let headerScrolled = false;
  let headerScrollFrame = 0;
  let headerPlaceholder = null;

  const updateHeaderScrollState = () => {
    if (headerScrollFrame) cancelAnimationFrame(headerScrollFrame);
    headerScrollFrame = requestAnimationFrame(() => {
      const header = document.querySelector("header");
      if (!header) return;

      const scrollY = Math.max(0, window.scrollY);
      const isDesktop = window.matchMedia("(min-width: 721px)").matches;
      if (isDesktop) {
        if (scrollY >= 64 && !headerScrolled) {
          const placeholder = document.createElement("div");
          placeholder.className = "header-placeholder";
          placeholder.setAttribute("aria-hidden", "true");
          placeholder.style.height = `${header.offsetHeight}px`;
          header.before(placeholder);
          headerPlaceholder = placeholder;
          headerScrolled = true;
          header.classList.add("is-scrolled");
        } else if (scrollY <= 16 && headerScrolled) {
          header.classList.remove("is-scrolled");
          if (headerPlaceholder) {
            headerPlaceholder.remove();
            headerPlaceholder = null;
          }
          headerScrolled = false;
        }
        headerScrollFrame = 0;
        return;
      }

      const enterThreshold = 48;
      const leaveThreshold = 16;
      const shouldBeScrolled = headerScrolled
        ? scrollY > leaveThreshold
        : scrollY >= enterThreshold;

      if (shouldBeScrolled && !headerScrolled) {
        const placeholder = document.createElement("div");
        placeholder.className = "header-placeholder";
        placeholder.setAttribute("aria-hidden", "true");
        placeholder.style.height = `${header.offsetHeight}px`;
        header.before(placeholder);
        headerPlaceholder = placeholder;
        headerScrolled = true;
        header.classList.add("is-scrolled");
      } else if (!shouldBeScrolled && headerScrolled) {
        header.classList.remove("is-scrolled");
        if (headerPlaceholder) {
          headerPlaceholder.remove();
          headerPlaceholder = null;
        }
        headerScrolled = false;
      }
      headerScrollFrame = 0;
    });
  };

  updateHeaderCart();
  updateHeaderScrollState();
  window.addEventListener("wmkc:cart-updated", updateHeaderCart);
  window.addEventListener("storage", updateHeaderCart);
  window.addEventListener("scroll", updateHeaderScrollState, { passive: true });

  document.addEventListener("astro:page-load", () => {
    updateHeaderCart();
    updateHeaderScrollState();
    const menuButton = document.getElementById("menu");
    const closeButton = document.getElementById("menu-close");
    const navbar = document.getElementById("primary-navigation");
    if (!menuButton || !closeButton || !navbar) return;

    const closeMenu = () => {
      navbar.classList.remove("show");
      menuButton.setAttribute("aria-expanded", "false");
      menuButton.focus();
    };

    menuButton.addEventListener("click", () => {
      navbar.classList.add("show");
      menuButton.setAttribute("aria-expanded", "true");
      closeButton.focus();
    });
    closeButton.addEventListener("click", closeMenu);
    navbar.querySelectorAll(".internal-links a").forEach((link) => {
      link.addEventListener("click", () => {
        navbar.classList.remove("show");
        menuButton.setAttribute("aria-expanded", "false");
      });
    });
    navbar.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && navbar.classList.contains("show")) closeMenu();
    });
  });

  const desktopNavigation = window.matchMedia("(min-width: 721px)");
  desktopNavigation.addEventListener("change", (event) => {
    if (!event.matches) return;
    const navbar = document.getElementById("primary-navigation");
    const menuButton = document.getElementById("menu");
    if (!navbar || !menuButton) return;
    navbar.classList.remove("show");
    menuButton.setAttribute("aria-expanded", "false");
  });
</script>
<style>
  .header-placeholder {
    display: block;
    width: 100%;
    overflow-anchor: none;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    transition:
      padding 220ms ease,
      box-shadow 220ms ease;
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: 1280px;
    min-height: 5rem;
    margin: 0 auto;
  }
  nav a {
    padding: 0.75em 0.5em;
    color: var(--primary);
    border-bottom: 4px solid transparent;
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--secondary);
  }

  .navbar {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .navbar .social-links {
    align-items: center;
    margin-top: 0;
  }

  .navbar .social-links a.cart-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0;
    border-bottom: 0;
    color: var(--secondary);
    transition: color 0.2s ease;
  }

  .navbar .social-links a.cart-link :global(svg) {
    width: 32px;
    height: 32px;
  }

  .navbar .social-links a.cart-link:hover,
  .navbar .social-links a.cart-link:focus-visible {
    color: var(--primary);
  }

  .cart-count {
    position: absolute;
    top: -0.65rem;
    right: -0.4rem;
    display: inline-grid;
    min-width: 1rem;
    height: 1rem;
    place-items: center;
    border-radius: 50%;
    padding: 0 0.1rem;
    background: var(--primary);
    color: white;
    font-size: 0.7rem;
    line-height: 1;
  }

  .cart-count[hidden] {
    display: none;
  }

  .burger {
    display: none;
    cursor: pointer;
    background: none;
    border: none;
    color: var(--secondary);
  }

  .mobile-actions {
    display: none;
  }

  .mobile-cart-link {
    display: none;
  }

  .top-right {
    position: absolute;
    top: 0;
    right: 0;
  }

  @media (max-width: 720px) {
    header {
      position: relative;
    }

    nav {
      min-height: 7.5rem;
    }

    nav .logo {
      width: 150px;
    }

    .mobile-actions {
      right: 0;
    }

    .mobile-actions {
      position: absolute;
      top: 50%;
      right: 0;
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.75rem;
      transform: translateY(-50%);
    }

    .mobile-cart-link {
      box-sizing: border-box;
      position: relative;
      display: inline-flex;
      width: 2.75rem;
      height: 2.75rem;
      align-items: center;
      justify-content: center;
      padding: 0;
      border-bottom: 0;
      color: var(--secondary);
    }

    .mobile-cart-link :global(svg) {
      width: 32px;
      height: 32px;
    }

    .mobile-cart-link .cart-count {
      top: 0;
      right: 0;
    }

    .burger {
      display: block;
      flex: 0 0 2.75rem;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
    }

    .navbar .top-right {
      top: 0;
      transform: none;
    }

    .navbar {
      display: none;
      position: fixed;
      top: 0;
      bottom: 0;
      right: 0;
      z-index: 20;
      width: min(320px, 100vw);
      flex-direction: column;
      background-color: var(--background-cream);
      box-shadow: var(--box-shadow);
    }

    .navbar.show {
      display: flex;
    }

    .social-links {
      padding: 3rem 0;
    }

    .internal-links {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      flex: 1;
    }

    nav a {
      font-size: 1.25rem;
    }

    nav a.active {
      border-bottom: 4px solid transparent;
    }
  }

  header.is-scrolled {
    width: 100%;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
    border-radius: 0;
    padding: 0 1rem;
    box-shadow: 0 4px 16px rgba(var(--black), 12%);
  }

  header.is-scrolled nav {
    min-height: 3.5rem;
  }

  @media (min-width: 721px) {
    header.is-scrolled {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 4rem;
      box-sizing: border-box;
      padding: 0.5rem 1rem;
    }

    header.is-scrolled nav {
      height: 3rem;
      min-height: 3rem;
    }

    header.is-scrolled .logo {
      width: 64px;
    }

    header.is-scrolled .navbar {
      display: flex;
      position: static;
      width: auto;
      flex-direction: row;
      justify-content: space-between;
      padding: 0;
      background: transparent;
      box-shadow: none;
    }

    header.is-scrolled .internal-links {
      flex: initial;
      flex-direction: row;
      justify-content: initial;
      gap: 0;
    }

    header.is-scrolled nav a {
      padding: 0.375em 0.25em;
    }

    header.is-scrolled .navbar .social-links {
      padding: 0;
    }

    header.is-scrolled .navbar .social-links a.cart-link :global(svg) {
      width: 24px;
      height: 24px;
    }
  }

  @media (max-width: 720px) {
    header.is-scrolled {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      height: 4rem;
      box-sizing: border-box;
      overflow: visible;
      padding: 1rem 0.75rem;
      animation: mobile-header-enter 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    header.is-scrolled nav {
      height: 2rem;
      min-height: 2rem;
      gap: 0;
      justify-content: flex-start;
      animation: compact-nav-enter 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    header.is-scrolled h2,
    header.is-scrolled h2 a {
      height: 2rem;
      display: flex;
      align-items: center;
      padding: 0;
    }

    header.is-scrolled h2 {
      animation: compact-content-down 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    header.is-scrolled .logo {
      display: block;
      width: 2.75rem;
      height: 2.75rem;
      object-fit: contain;
    }

    header.is-scrolled .navbar {
      display: none;
      position: fixed;
      top: 0;
      bottom: 0;
      right: 0;
      z-index: 21;
      width: min(320px, 100vw);
      flex-direction: column;
      justify-content: center;
      padding: 4rem 1.5rem 1.5rem;
      background-color: var(--background-cream);
      box-shadow: var(--box-shadow);
    }

    header.is-scrolled .navbar.show {
      display: flex;
    }

    header.is-scrolled .internal-links {
      flex: 1;
      flex-direction: column;
      justify-content: center;
      gap: 0.5rem;
    }

    header.is-scrolled .navbar .social-links {
      padding: 1.5rem 0 0;
    }

    header.is-scrolled .mobile-actions {
      position: absolute;
      top: 50%;
      right: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0;
      transform: translateY(-50%);
    }

    header.is-scrolled .mobile-cart-link {
      box-sizing: border-box;
      position: relative;
      display: inline-flex;
      width: 2.25rem;
      height: 2.25rem;
      align-items: center;
      justify-content: center;
      padding: 0;
      border-bottom: 0;
      color: var(--secondary);
    }

    header.is-scrolled .mobile-cart-link :global(svg) {
      width: 28px;
      height: 28px;
    }

    header.is-scrolled .mobile-cart-link .cart-count {
      top: 0;
      right: 0;
    }

    header.is-scrolled .burger {
      display: block;
      flex: 0 0 2.25rem;
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
    }

    header.is-scrolled .burger svg {
      width: 28px;
      height: 28px;
    }
  }

  @keyframes mobile-header-enter {
    from {
      opacity: 0;
      transform: translateY(-100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
