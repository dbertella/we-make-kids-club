---
import type { CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";

type Props = { data: { news: CollectionEntry<"news">["data"] } };

const { seoTitle, seoDescription, heroImage } = Astro.props.data.news;
---

<SiteLayout title={seoTitle} description={seoDescription} image={heroImage}>
  <main>
    <slot />
  </main>
</SiteLayout>
