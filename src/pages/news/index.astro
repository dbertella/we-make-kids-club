---
import SiteLayout from "../../layouts/SiteLayout.astro";
import config from "../../content/config/config.json";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<SiteLayout title={config.seo.title} description={config.seo.description}>
  <main class="news-index">
    <h1 class="news-heading">Latest news &amp; ideas</h1>
    <section aria-label="Latest news">
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/news/${post.id}`}>
                <img
                  width={720}
                  height={360}
                  src={post.data.heroImage}
                  alt=""
                />
                <p class="date">
                  <strong>{post.data.category}</strong>
                </p>
                <h2 class="title">{post.data.title}</h2>
                <p class="gray-dark">{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</SiteLayout>

<style>
  .news-index {
    width: 100%;
    max-width: 1120px;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul li {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  ul li:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(var(--black), 0.1);
  }

  ul li:first-child {
    grid-column: 1 / -1;
    text-align: center;
  }

  ul li * {
    text-decoration: none;
  }

  ul li a {
    display: block;
    height: 100%;
    padding-bottom: 1rem;
  }

  ul li img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 0.5rem;
    border-radius: 0;
  }

  .title {
    margin: 0.5rem 1rem;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    line-height: 1.2;
    font-family: var(--header-font);
    color: var(--secondary);
  }

  .date {
    margin: 0 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .gray-dark {
    margin: 0.5rem 1rem 0;
  }

  ul li:first-child .title {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
  }

  ul li a:hover .title,
  ul li a:focus-visible .title {
    color: rgb(var(--black));
  }

  ul li a:focus-visible {
    outline: 3px solid var(--secondary);
    outline-offset: -3px;
  }

  @media (max-width: 720px) {
    ul {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    ul li:first-child {
      grid-column: auto;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ul li {
      transition: none;
    }
  }
</style>
