---
import Stripe from "stripe";
import SiteLayout from "../layouts/SiteLayout.astro";

export const prerender = false;

const sessionId = Astro.url.searchParams.get("session_id");
let isPaid = false;

if (sessionId) {
  try {
    const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY);
    const session = await stripe.checkout.sessions.retrieve(sessionId);
    isPaid = session.payment_status === "paid";
  } catch (error) {
    console.error("Could not verify Stripe Checkout Session:", error);
  }
}
---

<SiteLayout
  title={isPaid ? "Thank You — We Make Kids Club" : "Payment Not Confirmed — We Make Kids Club"}
  description={isPaid ? "Your order is confirmed. Thank you for shopping with us." : "We could not confirm your payment. Please contact us or return to the store."}
>
  <main class="checkout-result" data-payment-status={isPaid ? "paid" : "unconfirmed"}>
    <a class="store-back-link" href="/store">&larr; Back to store</a>
    <div class:list={["result-mark", { "result-mark-error": !isPaid }]} aria-hidden="true">
      {isPaid ? "✓" : "!"}
    </div>
    <h1>{isPaid ? "Order confirmed" : "Payment not confirmed"}</h1>
    <p>
      {isPaid
        ? "Thank you for your purchase. Your payment was confirmed, and your order is being processed."
        : "We couldn't confirm a completed payment. Please check your Stripe confirmation email or contact us if you were charged."}
    </p>
    {isPaid && sessionId && <p class="session-id">Reference: <code>{sessionId}</code></p>}
  </main>
</SiteLayout>

<script is:inline>
  const clearCartAfterPaidOrder = () => {
    const paidOrder = document.querySelector('[data-payment-status="paid"]');
    if (!paidOrder || paidOrder.dataset.cartCleared === "true") return;

    localStorage.setItem("wemakekidsclub-cart", "[]");
    window.dispatchEvent(new Event("wmkc:cart-updated"));
    paidOrder.dataset.cartCleared = "true";
  };

  clearCartAfterPaidOrder();
  document.addEventListener("astro:page-load", clearCartAfterPaidOrder);
</script>
