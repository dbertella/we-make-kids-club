---
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import StorePage from "../components/StorePage.tsx";
import client from "../../tina/__generated__/client";
import { toProduct } from "../data/products";

const data = await client.queries.page({ relativePath: "shop.mdx" });
const products = (await getCollection("products")).map(
  (entry: CollectionEntry<"products">) =>
    toProduct({ ...entry.data, slug: entry.id }),
);
---

<SiteLayout
  title={data.data.page.seoTitle}
  description={data.data.page.seoDescription}
>
  <StorePage {...data} products={products} client:load />
</SiteLayout>
