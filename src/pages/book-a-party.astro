---
import SiteLayout from "../layouts/SiteLayout.astro";
import Page from "../../tina/pages/Page";
import client from "../../tina/__generated__/client";
import BookPartyForm from "../components/BookPartyForm.astro";

const data = await client.queries.page({ relativePath: "book-a-party.mdx" });
---

<SiteLayout
  title={data.data.page.seoTitle}
  description={data.data.page.seoDescription}
>
  <Page {...data} client:tina />
  <BookPartyForm />
</SiteLayout>
