---
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import StorePage from "../components/StorePage.tsx";
import { toProduct } from "../data/products";
import config from "../content/config/config.json";

const products = (await getCollection("products")).map(
  (entry: CollectionEntry<"products">) =>
    toProduct({ ...entry.data, slug: entry.id }),
);
---

<SiteLayout
  title={config.storeSEO.seoTitle}
  description={config.storeSEO.seoDescription}
>
  <StorePage products={products} client:load />
</SiteLayout>
