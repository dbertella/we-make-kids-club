---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StorePage from "../components/StorePage.tsx";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Eco-Friendly Crafts & Workshops Store | We Make Kids Club"
      description="Shop eco-friendly craft kits and workshops for kids from We Make Kids Club."
    />
  </head>
  <body>
    <Header />
    <StorePage client:load />
    <Footer />
  </body>
</html>

<style is:global>
  .store {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .store-heading {
    margin-bottom: 2rem;
    text-align: center;
  }

  .store-heading h1 {
    margin-bottom: 0.5rem;
    color: #2c5f2d;
    font-family: "Cherry Bomb One", cursive;
  }

  .store-heading p,
  .product-info > p,
  .store-footer p {
    color: #626262;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .product-card {
    overflow: hidden;
    border: 1px solid #e1e6df;
    border-radius: 8px;
    background: #fff;
  }

  .product-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: #f3f5f2;
  }

  .product-info {
    padding: 1.25rem;
  }

  .product-info h2,
  .cart h2,
  .store-footer h2 {
    margin-top: 0;
    color: #2c5f2d;
    font-size: 1.25rem;
  }

  .price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .price,
  .cart-total {
    color: #2c5f2d;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .store button {
    border: 0;
    border-radius: 4px;
    padding: 0.7rem 1rem;
    background: #2c5f2d;
    color: #fff;
    cursor: pointer;
    font: inherit;
  }

  .store button:hover {
    background: #1e4521;
  }

  .store .product-add-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .product-cart-count {
    display: inline-grid;
    min-width: 1.4rem;
    height: 1.4rem;
    place-items: center;
    border-radius: 50%;
    padding: 0 0.2rem;
    background: #fff;
    color: #2c5f2d;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .store button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .cart {
    margin-top: 2rem;
    border-top: 1px solid #e1e6df;
    padding-top: 1.5rem;
  }

  .cart ul {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .cart li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
  }

  .cart li button {
    background: transparent;
    color: #2c5f2d;
    text-decoration: underline;
  }

  .store-error {
    color: #a32121;
  }

  .store-footer {
    margin-top: 3rem;
    border-top: 1px solid #e1e6df;
    padding: 2rem 0;
    text-align: center;
  }

  @media (max-width: 480px) {
    .store {
      padding: 1rem;
    }

    .cart li {
      grid-template-columns: 1fr auto;
    }

    .cart li button {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
