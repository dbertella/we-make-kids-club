# TinaCloud (get both values from your Tina project settings)
PUBLIC_TINA_CLIENT_ID=your-tina-client-id
TINA_TOKEN=your-tina-read-only-token

# Stripe server-side Checkout
STRIPE_SECRET_KEY=sk_test_YourSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSigningSecretHere

# Purchase confirmation email via Resend
RESEND_API_KEY=re_YourResendApiKeyHere
SEND_EMAIL_FROM=We Make Kids Club <orders@your-verified-domain.com>

# Optional: Redirect URLs for production
SITE_URL=https://wemakekidsclub.com
